# PLANNED EXAMPLE ONLY: server mode is not implemented, and this unit is not
# currently usable. Do not install or enable it.

[Unit]
Description=Vulkanize GGUF Inference Server
After=network.target

[Service]
Type=simple
User=vulkanize
Group=vulkanize
# Future command shape; the current `serve` command is only a stub.
ExecStart=/usr/local/bin/vulkanize serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Vulkan needs access to GPU devices
DeviceAllow=/dev/dri rw

# Environment
Environment=RUST_LOG=info
Environment=VK_LAYER_PATH=/usr/share/vulkan/explicit_layer.d

[Install]
WantedBy=multi-user.target
